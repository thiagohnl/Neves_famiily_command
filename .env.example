# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Calendar (read-only display on the board)
# Secret iCal URL: Google Calendar > Settings > [your calendar] > Integrate calendar
# > "Secret address in iCal format". Server-side only — must NOT be prefixed VITE_.
GOOGLE_CALENDAR_ICS_URL=your_secret_ical_url

# Presence endpoint (/api/presence): shared secret phones send in the x-presence-key header.
# Server-side only — must NOT be prefixed VITE_.
PRESENCE_SHARED_KEY=a_long_random_string

